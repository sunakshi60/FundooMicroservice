{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "fundoo-user-api",
    "Audience": "fundoo-clients",
    "ExpiryMinutes": 30
  },
  "NotificationService": {
    "BaseUrl": "http://localhost:5230/"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "NotificationTopic": "fundoo-notifications"
  }
}
